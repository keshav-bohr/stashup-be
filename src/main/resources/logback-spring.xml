<?xml version="1.0" encoding="UTF-8"?>
<!--
  Local development uses a readable pattern that still surfaces the correlation ID.

  Every other profile uses Spring Boot's native structured logging (configured in
  application.yml as logging.structured.format.console), so no third-party JSON encoder is
  needed. Structured output carries the correlation ID and trace context, which is what makes a
  single request traceable end to end (constitution Principle VI).

  Monetary amounts and PII must never reach this output. That is enforced at the call sites and
  asserted by LogRedactionIT - a formatter cannot know what a value means.
-->
<configuration>
  <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

  <springProfile name="local">
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
      <encoder>
        <pattern>%d{HH:mm:ss.SSS} %-5level [%X{correlationId:-no-correlation}] %logger{36} - %msg%n</pattern>
      </encoder>
    </appender>
    <root level="INFO">
      <appender-ref ref="CONSOLE"/>
    </root>
  </springProfile>
</configuration>
